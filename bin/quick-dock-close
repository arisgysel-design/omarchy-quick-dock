#!/usr/bin/env bash
# Optional helper for a close key such as Super+W: hides Quick Dock when it is
# open, otherwise closes the active window.
#
# Hyprland, not the shell, answers whether the dock is open, so closing windows
# keeps working even when omarchy-shell is slow, hung or not running.

set -uo pipefail

# Must match manifest.json and `layerNamespace` in QuickDock.qml (checked by tests).
readonly PLUGIN_ID="arisgysel-design.quick-dock"
readonly LAYER_NAMESPACE="quick-dock"
readonly HIDE_TIMEOUT_SECONDS=2

# An unknown state must never turn a dock-close key into a window-close key.
# Read the complete response before parsing it, avoiding broken-pipe failures.
layers=$(hyprctl layers -j 2>/dev/null) || exit 1
dock_open=$(jq -sr --arg namespace "$LAYER_NAMESPACE" '
  if length != 1 then error("expected one layers response") else .[0] end
  | if type != "object" then error("expected layers object") else . end
  | [ .[] | .levels
      | if type != "object" then error("expected levels object") else . end
      | to_entries[] | .value
      | if type != "array" then error("expected layer array") else .[] end
      | .namespace ]
  | if all(.[]; type == "string") then any(.[]; . == $namespace)
    else error("invalid layer namespace") end
' <<< "$layers" 2>/dev/null) || exit 1

if [[ $dock_open == true ]]; then
  # While the dock is visible the key belongs to it; never close the window
  # underneath, even if hiding fails.
  timeout "$HIDE_TIMEOUT_SECONDS" omarchy-shell shell hide "$PLUGIN_ID" >/dev/null 2>&1 || true
else
  hyprctl dispatch 'hl.dsp.window.close()' >/dev/null
fi
